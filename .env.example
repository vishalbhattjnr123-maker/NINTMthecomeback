# Local server configuration
PORT=5000
NODE_ENV=development
SERVE_STATIC=false
GST_RATE=0

# Vercel Blob storage (optional for local development; required for persistent production uploads)
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Razorpay (required for checkout/payment)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email (optional; without these, confirmation emails are logged in the server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_EMAIL=""
